{
    "name": "@ortha/admin",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@ortha/activity-admin": "*",
        "@ortha/alarms-admin": "*",
        "@ortha/api-tokens-admin": "*",
        "@ortha/bootstrap-admin": "*",
        "@ortha/content-admin": "*",
        "@ortha/copilot-admin": "*",
        "@ortha/i18n-admin": "*",
        "@ortha/identity-admin": "*",
        "@ortha/insights-admin": "*",
        "@ortha/media-admin": "*",
        "@ortha/segments-admin": "*",
        "@ortha/shell-admin": "*",
        "@ortha/transfer-admin": "*",
        "@ortha/users-admin": "*",
        "@ortha/workspaces-admin": "*",
        "@ortha/wysiwyg-admin": "*"
    },
    "nx": {
        "name": "admin",
        "projectType": "application",
        "targets": {
            "dev:typecheck": {
                "continuous": true,
                "executor": "nx:run-commands",
                "options": {
                    "command": "tsc --build --emitDeclarationOnly --watch --preserveWatchOutput",
                    "cwd": "apps/admin"
                }
            }
        }
    }
}
