{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "rootDir": "src",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "templates", "**/*.spec.ts", "**/*.test.ts"]
}
