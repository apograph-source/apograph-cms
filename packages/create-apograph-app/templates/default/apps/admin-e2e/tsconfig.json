{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2023",
            "dom"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "node"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "playwright.config.ts"
    ]
}
