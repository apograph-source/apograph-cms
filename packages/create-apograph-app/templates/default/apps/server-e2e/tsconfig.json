{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2023"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "types": [
            "node",
            "jest"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "jest.config.js"
    ]
}
