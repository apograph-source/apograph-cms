# Port the API listens on. `orthacms start` serves the admin from here too.
PORT=3000
# Port the Vite dev server listens on (development only).
ADMIN_PORT=4200

# PostgreSQL connection string.
DATABASE_URL=__DATABASE_URL__

# How long a **delivered** outbox event stays in `outbox_events`, in days. The
# transactional outbox is a queue, not an archive: a row that every subscriber
# accepted has done its job, and until this existed nothing ever removed one, so
# the table grew for the life of the deployment. 0 keeps them forever.
#
# Only delivered rows are in scope. A pending event is still owed a delivery,
# and a **parked** one — fifteen failures, no longer retried — is the evidence
# that something was never recorded; neither is ever deleted by age, whatever
# this is set to.
OUTBOX_RETENTION_DAYS=30

# How many reverse proxies sit in front of the app (Express `trust proxy`).
# REQUIRED behind a load balancer, ingress or CDN: left unset, Express ignores
# X-Forwarded-For, every request reports the proxy's address, and the login
# rate limit collapses into ONE bucket for the whole deployment. Prefer the hop
# count (1 for a single proxy) — a client cannot forge past it.
TRUST_PROXY=

# Serve the API reference on /reference. On outside production by default.
API_DOCS=

# Largest JSON request body the API accepts. Defaults to 1mb.
MAX_REQUEST_BODY=

# --- media ---
# orthacms:if media-local
# Where uploads are written. Point this at a persistent volume in production:
# a container's own disk is wiped on every deploy.
MEDIA_LOCAL_ROOT=./.storage/media
# orthacms:end
# orthacms:if media-vercel-blob
# Vercel injects this on its own platform; set it only when running elsewhere.
# NOTE: every blob in this store gets a permanent, public URL — anyone who
# obtains one can fetch that asset without signing in. Do not pick this backend
# for confidential media.
BLOB_READ_WRITE_TOKEN=
# orthacms:end
# orthacms:if media-gcs
# The bucket every upload lands in. Required.
MEDIA_GCS_BUCKET=
# Leave the rest blank on GKE or Cloud Run: the client falls back to
# Application Default Credentials, which is the point of using this adapter
# instead of the S3-compatible one.
MEDIA_GCS_PROJECT_ID=
MEDIA_GCS_KEY_FILE=
# Sign URLs through IAM instead of a private key (Workload Identity). Needs
# the iam.serviceAccounts.signBlob permission.
MEDIA_GCS_SIGN_WITH_IAM=false
# orthacms:end
# orthacms:if media-azure
# The container every upload lands in, and how to reach the account. The portal
# hands you the connection string; Azurite prints one too. For managed identity,
# build the container client yourself in plugins.ts — see the package docs.
MEDIA_AZURE_CONTAINER=media
MEDIA_AZURE_CONNECTION_STRING=
# orthacms:end
# orthacms:if media-s3
# The bucket every upload lands in. Required.
MEDIA_S3_BUCKET=
# Leave the endpoint blank for AWS S3 itself. For anything else, set it:
#   Cloudflare R2  https://<account>.r2.cloudflarestorage.com
#   MinIO          http://localhost:9000   (also set FORCE_PATH_STYLE=true)
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_FORCE_PATH_STYLE=false
# Leave both blank on a host with an instance role or IRSA — the SDK finds
# those itself, and blanks here would shadow them with keys that cannot sign.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# orthacms:end
MEDIA_MAX_UPLOAD_BYTES=52428800

# --- first admin ---
# With an email set, an active admin is provisioned on boot — idempotent and
# non-destructive, so an existing account is left alone. This is how you get
# your first login; clear it once you have one.
ORTHACMS_ROOT_ADMIN_EMAIL=__ADMIN_EMAIL__
ORTHACMS_ROOT_ADMIN_PASSWORD=__ADMIN_PASSWORD__

# orthacms:if mail
# --- outgoing mail ---
# Which backend messages are handed to, and the switch that turns mail on at
# all. Leave it EMPTY and this app sends nothing: no queue, no worker, and the
# invite and reset routes keep returning the raw link for you to pass on by
# hand — which is how the CMS has always worked and is a complete configuration.
#
# Set it and two things change: the three messages are sent, and those routes
# stop handing back a secret, because two copies of an account-takeover link are
# worse than one. `POST /api/users/:id/reveal-link` is the audited way to see one
# when a message does not arrive.
MAIL_PROVIDER=
# The absolute URL this CMS is reached on. REQUIRED once MAIL_PROVIDER is set:
# every link in every message is built from it, and it is deliberately not taken
# from the request's Host header — the caller controls that, and an invitation is
# the one message a recipient is certain to click.
APP_URL=
# The sender, as the recipient sees it. REQUIRED once MAIL_PROVIDER is set: a
# message with no sender is refused by every relay.
MAIL_FROM=
# Where replies should go, when it is not MAIL_FROM.
MAIL_REPLY_TO=
# How the product refers to itself in the copy. Defaults to Ortha CMS.
MAIL_PRODUCT_NAME=
# Keep returning the raw link from the invite and reset routes AS WELL AS
# sending it. A delivery-debugging mode: leave it off unless you are chasing a
# message that did not arrive.
MAIL_REVEAL_LINKS=false
# How often the worker looks for queued messages, in milliseconds.
MAIL_DELIVERY_INTERVAL_MS=
# How many hand-off attempts a message gets before it is given up on.
MAIL_MAX_ATTEMPTS=
# orthacms:if mail-smtp
# The relay. One adapter reaches the market — Resend, SES, Postmark, SendGrid,
# Mailgun, Google Workspace, Microsoft 365 and anything inside your own
# perimeter all speak SMTP — so the host is the only value with no default.
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS, for port 465. Leave it EMPTY on 587: the connection is upgraded
# with STARTTLS instead, and `false` here is not the same as unset.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Refuse to send at all if the connection cannot be upgraded to TLS. Worth
# turning on for a relay on the public internet.
SMTP_REQUIRE_TLS=
SMTP_CONNECTION_TIMEOUT_MS=
# orthacms:end
# orthacms:end

# --- copilot ---
# Global kill switch. OFF by default: whether this app offers Ortha CMS AI at all is
# your call. `false` unregisters every /api/copilot route, so the endpoints 404
# and the admin's chat panel, Agents view and Skills page stand down.
#
# It is not what keeps your content in-house: a backend is registered only when
# it is configured below, so an app with no key reaches no third party whatever
# this says.
COPILOT_ENABLED=false
# Ceiling on a single model response, in tokens.
COPILOT_MAX_OUTPUT_TOKENS=8192
# orthacms:if copilot-anthropic
# Native Claude. Setting the key is what REGISTERS this backend — leave it empty
# and there is no `claude` in the picker at all, rather than one that fails on
# the first message. The key never leaves the server.
ANTHROPIC_API_KEY=
# Comma-separated. The FIRST is the default; the rest are what a user can switch
# to mid-conversation without a redeploy.
COPILOT_ANTHROPIC_MODELS=claude-sonnet-5
# orthacms:end
# orthacms:if copilot-openai
# An OpenAI-wire endpoint. Setting this REGISTERS the backend, and there is no
# default: an endpoint nobody named is a backend that can only time out. A local
# Ollama is http://localhost:11434/v1.
COPILOT_OPENAI_BASE_URL=
COPILOT_OPENAI_MODELS=llama3.1
# Leave empty for a local runtime that wants no auth.
COPILOT_OPENAI_API_KEY=
# orthacms:end
# orthacms:if graphql
# --- graphql ---
# The cost budget one GraphQL operation may spend. REST bounds a request
# structurally — one route, one page — and a document does not, so these are the
# replacement bound. The defaults suit an ordinary content API; loosen them only
# for a client you control.
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=1000
GRAPHQL_MAX_FIELDS=500
GRAPHQL_MAX_QUERY_LENGTH=16384
# How long a built schema is reused before it is derived again from the
# workspace's content grants. Freshness only — every read is authorized against
# the live grants regardless.
GRAPHQL_SCHEMA_CACHE_TTL_MS=60000
# orthacms:end
# orthacms:if mcp
# --- mcp ---
# Global kill switch. OFF by default: once on, any holder of a `full`-scope API
# token can drive content CRUD from an external agent. Agents connect to
# POST /api/v1/mcp with `Authorization: Bearer <token>`.
MCP_ENABLED=false
# Ceiling on one tools/call, in milliseconds. Defaults to 30000.
MCP_CALL_TIMEOUT_MS=
# Ceiling on one tool result, in bytes. Defaults to 4194304 (4 MB).
MCP_MAX_RESULT_BYTES=
# orthacms:end

# --- single sign-on ---
# orthacms:if sso-oidc
# Generic OpenID Connect — Okta, Auth0, Keycloak, Google, Entra ID and the rest.
# Both of these are what make the provider configured at all: an issuer with no
# client id is a sign-in button that can only fail.
#
# The issuer must match the `iss` claim byte for byte, trailing slash included
# (Auth0 issues with one). Register
# <origin>/api/auth/sso/<SSO_OIDC_NAME>/callback with the provider.
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
# What the route and every sso_identities row call this provider. Renaming it
# orphans the links that name it. Default: oidc
SSO_OIDC_NAME=
# The sign-in button's text. Defaults to the issuer's host.
SSO_OIDC_LABEL=
# Set to true ONLY if your provider never sends `email_verified` and you are
# asserting that this directory owns the addresses it reports (Microsoft Entra
# ID is the common case). That claim is the only gate on a first sign-in
# claiming an existing account.
SSO_OIDC_EMAIL_VERIFIED_WHEN_ABSENT=
# orthacms:end
# orthacms:if sso-github
# GitHub, or GitHub Enterprise Server. Both of these are what make the provider
# configured at all — and unlike OIDC the secret is not optional: GitHub's code
# exchange has no PKCE, so the secret is the only thing proving the code is
# being redeemed by this application.
# Register <origin>/api/auth/sso/<SSO_GITHUB_NAME>/callback as the OAuth app's
# authorization callback URL.
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
# What the route and every sso_identities row call this provider. Renaming it
# orphans the links that name it. Default: github
SSO_GITHUB_NAME=
# The sign-in button's text. Default: GitHub
SSO_GITHUB_LABEL=
# Comma-separated. Defaults to `read:user,user:email` — a profile and the
# verified addresses on it. GitHub's scopes are coarse, so anything wider hands
# this CMS access it has no use for.
SSO_GITHUB_SCOPES=
# For GitHub Enterprise Server, e.g. https://github.acme.com. Leave empty for
# github.com.
SSO_GITHUB_ENTERPRISE_BASE_URL=
# Restricts the account chooser to one organisation's members. Cosmetic: who
# actually gets in is this CMS's decision, not GitHub's.
SSO_GITHUB_ORGANIZATION=
# orthacms:end
# orthacms:if sso-saml
# SAML 2.0. All three are required and none has a fallback: SAML has no
# discovery document and no key endpoint, so the certificate you copy out of
# your identity provider is the whole of the trust relationship.
# The IdP's single-sign-on URL, where the AuthnRequest is sent.
SSO_SAML_ENTRY_POINT=
# The IdP's signing certificate, PEM or bare base64. An environment variable
# cannot hold real newlines, so `\n` escapes are accepted and put back.
SSO_SAML_IDP_CERT=
# This CMS's entity id — the Issuer on the AuthnRequest, and what the IdP has
# registered as the service provider.
SSO_SAML_ISSUER=
# What the route and every sso_identities row call this provider. Renaming it
# orphans the links that name it. Default: saml
SSO_SAML_NAME=
# The sign-in button's text. Default: SAML
SSO_SAML_LABEL=
# The attribute holding a STABLE identifier for the person. Worth setting
# whenever your IdP's NameID format is emailAddress: an address is not a stable
# identifier, and a profile whose subject is one is refused.
SSO_SAML_SUBJECT_ATTRIBUTE=
# Which attributes to read, when the usual spellings are not what your IdP
# sends. Left empty, each falls back to a list of the common ones.
SSO_SAML_EMAIL_ATTRIBUTE=
SSO_SAML_NAME_ATTRIBUTE=
SSO_SAML_GROUPS_ATTRIBUTE=
# Set to true ONLY if you are asserting that this directory owns the addresses
# it reports. SAML carries no verification claim at all — there is nothing to
# read — and this is the only gate on a first sign-in claiming an existing
# account.
SSO_SAML_EMAIL_VERIFIED=
# orthacms:end
# The origin browsers reach the API on, when the admin is served from a
# different one. Leave empty for the usual same-origin deployment.
SSO_PUBLIC_BASE_URL=
# How long one sign-in attempt stays live, in seconds. Default 600.
SSO_REQUEST_TTL_SECONDS=

# --- webhooks (outgoing notifications on content changes) ---
# Endpoints live in the database — add them in the admin's Webhooks page
# (administrator-only). These settings are how hard the sender pushes and where
# it is allowed to reach.
#
# How often the sender looks for queued deliveries, in milliseconds. 0 queues
# but never sends from this process.
WEBHOOKS_DELIVERY_INTERVAL=2000
# Per-request timeout, in milliseconds.
WEBHOOKS_TIMEOUT=10000
# How long a finished delivery stays in the log. Nothing else prunes it.
WEBHOOKS_RETENTION_DAYS=30
# Permit http:// destinations — for local development only; the payload is
# readable to anyone on the path even though it is signed.
WEBHOOKS_ALLOW_INSECURE_URLS=false
# Permit loopback and RFC 1918 destinations. OFF by default: a webhook is the
# server making a request to an address a user typed, which is the shape of
# every SSRF. Turn it on only if your receiver really is inside this network.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
